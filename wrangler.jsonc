{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xform-coaching-os",
  "account_id": "4a269f17a7c54e86f05aa8b207d1d6a5",
  "main": "deploy/worker.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "build": { "command": "pnpm build" },
  "observability": { "enabled": true },
  "containers": [{ "class_name": "XFormContainer", "image": "./Dockerfile", "max_instances": 1, "instance_type": "basic" }],
  "durable_objects": { "bindings": [{ "name": "XFORM_CONTAINER", "class_name": "XFormContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["XFormContainer"] }],
  "vars": { "XFORM_ENVIRONMENT": "production" }
}
