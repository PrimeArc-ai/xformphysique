XFORM_ENVIRONMENT=development
XFORM_DATABASE_URL=sqlite:///./data/xform.db
XFORM_STORAGE_DIR=./data/progress-photos
XFORM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Temporary identity seam until authentication is added. Do not accept this from client routes.
XFORM_DEMO_CLIENT_ID=cl_001

# Supabase Auth and Data API. The publishable key is deliberately low-privilege;
# every database request still runs under the caller's JWT and Row Level Security.
XFORM_SUPABASE_URL=https://<project-ref>.supabase.co
XFORM_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: required for coach-led client invitations. Never expose in Vite.
XFORM_SUPABASE_SECRET_KEY=sb_secret_...
# Must exactly match an allowed Supabase Auth redirect URL.
XFORM_CLIENT_INVITE_REDIRECT_URL=https://<your-frontend-domain>/

# Server-only scheduled WhatsApp reminder. The job endpoint is intended for a
# trusted scheduler, never the browser. Twilio needs an approved utility
# template; set From as whatsapp:+<number>.
XFORM_CHECKIN_REMINDER_JOB_TOKEN=replace-with-a-long-random-secret
XFORM_TWILIO_ACCOUNT_SID=AC...
XFORM_TWILIO_AUTH_TOKEN=...
XFORM_TWILIO_WHATSAPP_FROM=whatsapp:+1415...
XFORM_TWILIO_WHATSAPP_REMINDER_TEMPLATE_SID=HX...

# Private Cloudflare R2 Storage. Create an S3 API token scoped only to this
# bucket; never put these values in Vite or a browser.
XFORM_R2_ACCOUNT_ID=<cloudflare-account-id>
XFORM_R2_ACCESS_KEY_ID=<r2-access-key-id>
XFORM_R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
XFORM_R2_BUCKET_NAME=xform-progress-photos
# Optional. Derived from account ID when omitted.
# XFORM_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
