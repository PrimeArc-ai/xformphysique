XFORM_ENVIRONMENT=development
XFORM_DATABASE_URL=sqlite:///./data/xform.db
XFORM_STORAGE_DIR=./data/progress-photos
XFORM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Temporary identity seam until authentication is added. Do not accept this from client routes.
XFORM_DEMO_CLIENT_ID=cl_001

# Supabase Auth and Data API. The publishable key is deliberately low-privilege;
# every database request still runs under the caller's JWT and Row Level Security.
XFORM_SUPABASE_URL=https://<project-ref>.supabase.co
XFORM_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: required for coach-led client invitations. Never expose in Vite.
XFORM_SUPABASE_SECRET_KEY=sb_secret_...
# Must exactly match an allowed Supabase Auth redirect URL.
XFORM_CLIENT_INVITE_REDIRECT_URL=https://<your-frontend-domain>/
